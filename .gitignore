# 构建产物
build/
cmake-build-*/
*.o
*.elf
*.bin
*.hex

# STM32Cube 扩展 runtime 状态（bundles 锁定信息等，可由 cube bundle init 重建）
.settings/

# Python
__pycache__/
*.pyc
.venv/
venv/

# 编辑器/系统
.vscode/
.idea/
*.swp
.DS_Store

# Obsidian 知识库：跟踪核心 markdown 笔记 + .obsidian/ 双链生态配置
# （核心插件开关/主题/快捷键/插件数据跨设备同步；仅排除设备相关运行时文件）
obsidian/.obsidian/workspace.json
obsidian/.obsidian/workspace-mobile.json
obsidian/.obsidian/cache/
obsidian/**/attachments/
obsidian/**/*.png
obsidian/**/*.jpg
obsidian/**/*.jpeg
obsidian/**/*.gif
obsidian/**/*.pdf
obsidian/**/*.svg

# 敏感信息
*.key
*.pem

# 参考仓库（方案 C：不纳入 git，换机重新 clone）
S90_aim_ball/
